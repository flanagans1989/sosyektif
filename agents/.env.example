# Bu dosyayı .env olarak kopyalayıp doldur (yerel test için).
# GitHub Actions'ta bu değerler repo Secrets'tan gelir — .env asla commit edilmez.

# --- LLM sağlayıcıları (çoklu, fallback zinciri — PLAN.md Bölüm 4) ---
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- Görsel ---
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Trend Ajanı ---
YOUTUBE_API_KEY=

# --- Bildirim / onay ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_PUBLIC_CHANNEL_ID=

# --- Dağıtım ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Threads/Instagram token'ları Worker'ın KV'sinden okunur (bkz.
# agents/src/lib/metaToken.ts). Bu anahtar Worker'daki AGENT_PAYLASIM_ANAHTARI
# ile birebir aynı olmalı (Worker'ın /tetikle sırrından ayrı, Cloudflare
# dashboard > sosyektif-telegram-onay > Settings > Variables and Secrets).
AGENT_PAYLASIM_ANAHTARI=

# --- Analitik ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
