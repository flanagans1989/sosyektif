---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const tumYazilar = await getCollection('posts', ({ data }) => !data.taslak && Boolean(data.duzeltmeNotu));
const yazilar = tumYazilar.sort(
  (a, b) => (b.data.guncellemeTarihi ?? b.data.yayinTarihi).valueOf() - (a.data.guncellemeTarihi ?? a.data.yayinTarihi).valueOf()
);

const tarihFormati = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Istanbul',
});
---

<Layout
  title="Düzeltmeler"
  description="sosyektif'te yayınlandıktan sonra düzeltilen içeriklerin şeffaf kaydı."
>
  <article class="prose prose-neutral mx-auto max-w-2xl px-4 py-12">
    <h1>Düzeltmeler</h1>
    <p>
      Otomasyona ve denetime rağmen hatalar olabilir. Yayınlandıktan sonra düzeltilen bir
      içerikte ne değiştiğini burada şeffafça listeliyoruz — bkz.
      <a href="/editoryal-politika/">editoryal politikamız</a>. Bir hata görürseniz
      <a href="/iletisim/">iletişim sayfamızdan</a> bize bildirin.
    </p>

    {yazilar.length === 0 ? (
      <p class="text-murekkep/60">Şu ana kadar herhangi bir düzeltme kaydı yok.</p>
    ) : (
      <ul>
        {yazilar.map((yazi) => (
          <li>
            <a href={`/${yazi.id}/`}>{yazi.data.baslik}</a>
            <br />
            <span class="text-sm text-murekkep/60">
              {tarihFormati.format(yazi.data.guncellemeTarihi ?? yazi.data.yayinTarihi)} — {yazi.data.duzeltmeNotu}
            </span>
          </li>
        ))}
      </ul>
    )}
  </article>
</Layout>
