---
import Layout from '../../layouts/Layout.astro';
import { BURCLAR, BURC_ANAHTARLARI, type BurcAnahtari } from '../../lib/burclar';
import gunlukBurc from '../../data/gunluk-burc.json';

const burclarVerisi = gunlukBurc.burclar as Record<
  BurcAnahtari,
  { yorum: string; sansliSayi: number; sansliRenk: string }
>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Günlük Burç Yorumları',
  description: `${gunlukBurc.tarih} tarihli günlük burç yorumları`,
};
---

<Layout title="Günlük Burç Yorumları" description="12 burç için her gün güncellenen günlük burç yorumu, şanslı sayı ve şanslı renk.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-extrabold text-murekkep">🔮 Günlük Burç Yorumları</h1>
    <p class="mt-2 text-murekkep/70">Burcunu seç, günlük yorumunu ilk sen gör.</p>

    <div id="burcum-alani" class="mt-6"></div>

    <div id="burc-secici" class="mt-8 hidden">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-murekkep/50">Burcun hangisi?</h2>
      <div class="grid grid-cols-3 gap-2 sm:grid-cols-4">
        {BURC_ANAHTARLARI.map((anahtar) => (
          <button
            type="button"
            class="burc-sec-buton flex flex-col items-center gap-1 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:shadow-md"
            data-burc={anahtar}
          >
            <span class="text-3xl">{BURCLAR[anahtar].emoji}</span>
            <span class="text-sm font-bold text-murekkep">{BURCLAR[anahtar].isim}</span>
            <span class="text-[11px] text-murekkep/50">{BURCLAR[anahtar].tarihAraligi}</span>
          </button>
        ))}
      </div>
    </div>

    <section class="mt-10">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-xl font-bold text-murekkep">Tüm Burçlar</h2>
        <button id="burcumu-degistir" class="hidden text-sm font-semibold text-marka underline">Burcumu değiştir</button>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {BURC_ANAHTARLARI.map((anahtar) => (
          <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5" id={`burc-karti-${anahtar}`}>
            <div class="flex items-center gap-2">
              <span class="text-2xl">{BURCLAR[anahtar].emoji}</span>
              <div>
                <h3 class="font-bold text-murekkep">{BURCLAR[anahtar].isim}</h3>
                <p class="text-xs text-murekkep/50">{BURCLAR[anahtar].tarihAraligi}</p>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-murekkep/80">{burclarVerisi[anahtar]?.yorum}</p>
            <p class="mt-3 text-xs font-semibold text-marka">
              🍀 Şanslı sayı: {burclarVerisi[anahtar]?.sansliSayi} · Şanslı renk: {burclarVerisi[anahtar]?.sansliRenk}
            </p>
          </div>
        ))}
      </div>
    </section>

    <p class="mt-6 text-center text-xs text-murekkep/40">
      Bu yorumlar eğlence amaçlıdır, kesin bir öngörü olarak değerlendirilmemelidir. Her gün yenilenir.
    </p>
  </div>

  <script type="application/json" id="burc-verisi" set:html={JSON.stringify({ tarih: gunlukBurc.tarih, burclar: burclarVerisi })} />
  <script type="application/json" id="burc-bilgi" set:html={JSON.stringify(BURCLAR)} />

  <script>
    const DEPO_ANAHTARI = 'sosyektif-burc';

    interface BurcVeri {
      tarih: string;
      burclar: Record<string, { yorum: string; sansliSayi: number; sansliRenk: string }>;
    }
    interface BurcBilgi {
      isim: string;
      emoji: string;
      tarihAraligi: string;
    }

    function veriOku<T>(id: string): T | null {
      const el = document.getElementById(id);
      return el?.textContent ? (JSON.parse(el.textContent) as T) : null;
    }

    function kayitliBurc(): string | null {
      try {
        return localStorage.getItem(DEPO_ANAHTARI);
      } catch {
        return null;
      }
    }

    function burcKaydet(anahtar: string): void {
      try {
        localStorage.setItem(DEPO_ANAHTARI, anahtar);
      } catch {
        // localStorage kapalıysa sessizce yoksay.
      }
    }

    function burcumAlaniniGoster(anahtar: string, veri: BurcVeri, bilgi: Record<string, BurcBilgi>): void {
      const alan = document.getElementById('burcum-alani');
      const secici = document.getElementById('burc-secici');
      const degistirButon = document.getElementById('burcumu-degistir');
      if (!alan) return;

      const b = veri.burclar[anahtar];
      const info = bilgi[anahtar];
      if (!b || !info) return;

      const paylasimMetni = `Bugün ${info.isim} burcu için: "${b.yorum}" 🔮 sosyektif.com'da senin burcuna da bak!`;
      const paylasimUrl = `https://wa.me/?text=${encodeURIComponent(`${paylasimMetni} ${location.origin}/burc/`)}`;

      alan.innerHTML = `
        <div class="rounded-2xl bg-marka px-6 py-6 text-white shadow-sm">
          <p class="text-sm font-semibold text-white/70">Bugünün yorumu</p>
          <div class="mt-1 flex items-center gap-2">
            <span class="text-4xl">${info.emoji}</span>
            <h2 class="text-2xl font-extrabold">${info.isim}</h2>
          </div>
          <p class="mt-3 leading-relaxed">${b.yorum}</p>
          <p class="mt-3 text-sm font-semibold text-white/90">🍀 Şanslı sayı: ${b.sansliSayi} · Şanslı renk: ${b.sansliRenk}</p>
          <a href="${paylasimUrl}" target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1 rounded-full bg-white px-5 py-2 text-sm font-bold text-marka transition hover:bg-white/90">
            WhatsApp'ta Paylaş
          </a>
        </div>
      `;

      secici?.classList.add('hidden');
      degistirButon?.classList.remove('hidden');

      // Kendi burcunun kartını "Tüm Burçlar" listesinde de vurgula.
      document.querySelectorAll('[id^="burc-karti-"]').forEach((el) => el.classList.remove('ring-2', 'ring-marka'));
      document.getElementById(`burc-karti-${anahtar}`)?.classList.add('ring-2', 'ring-marka');
    }

    function baslat(): void {
      const veri = veriOku<BurcVeri>('burc-verisi');
      const bilgi = veriOku<Record<string, BurcBilgi>>('burc-bilgi');
      if (!veri || !bilgi) return;

      const secili = kayitliBurc();
      const secici = document.getElementById('burc-secici');
      const degistirButon = document.getElementById('burcumu-degistir');

      if (secili && veri.burclar[secili]) {
        burcumAlaniniGoster(secili, veri, bilgi);
      } else {
        secici?.classList.remove('hidden');
      }

      document.querySelectorAll<HTMLButtonElement>('.burc-sec-buton').forEach((buton) => {
        buton.addEventListener('click', () => {
          const anahtar = buton.dataset.burc;
          if (!anahtar) return;
          burcKaydet(anahtar);
          burcumAlaniniGoster(anahtar, veri, bilgi);
        });
      });

      degistirButon?.addEventListener('click', () => {
        secici?.classList.remove('hidden');
        document.getElementById('burcum-alani')!.innerHTML = '';
        degistirButon.classList.add('hidden');
      });
    }

    baslat();
  </script>
</Layout>
