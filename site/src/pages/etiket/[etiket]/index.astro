---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { etiketSlugla } from '../../../lib/etiketler';

export async function getStaticPaths() {
  const tumYazilar = await getCollection('posts', ({ data }) => !data.taslak);

  // slug -> gerçek görüntülenen etiket adı (ilk rastlanan yazım korunur)
  const etiketAdlari = new Map<string, string>();
  for (const yazi of tumYazilar) {
    for (const etiket of yazi.data.etiketler) {
      const slug = etiketSlugla(etiket);
      if (slug && !etiketAdlari.has(slug)) etiketAdlari.set(slug, etiket);
    }
  }

  return Array.from(etiketAdlari.entries()).map(([slug, ad]) => ({
    params: { etiket: slug },
    props: { etiketAdi: ad },
  }));
}

const { etiket } = Astro.params as { etiket: string };
const { etiketAdi } = Astro.props as { etiketAdi: string };

const tumYazilar = await getCollection(
  'posts',
  ({ data }) => !data.taslak && data.etiketler.some((e) => etiketSlugla(e) === etiket)
);
const yazilar = tumYazilar.sort(
  (a, b) => b.data.yayinTarihi.valueOf() - a.data.yayinTarihi.valueOf()
);
---

<Layout
  title={`#${etiketAdi}`}
  description={`#${etiketAdi} etiketli en yeni içerikler.`}
  noindex={yazilar.length === 0}
>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="mb-6 text-3xl font-extrabold text-murekkep">#{etiketAdi}</h1>

    {yazilar.length === 0 ? (
      <p class="text-murekkep/60">Bu etikette henüz içerik yok.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {yazilar.map((yazi) => <PostCard post={yazi} />)}
      </div>
    )}
  </section>
</Layout>
