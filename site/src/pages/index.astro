---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';

const tumYazilar = await getCollection('posts', ({ data }) => !data.taslak);
const yazilar = tumYazilar.sort(
  (a, b) => b.data.yayinTarihi.valueOf() - a.data.yayinTarihi.valueOf()
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'sosyektif',
      url: 'https://sosyektif.com/',
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://sosyektif.com/ara/?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      name: 'sosyektif',
      url: 'https://sosyektif.com/',
      logo: 'https://sosyektif.com/favicon.svg',
    },
  ],
};
---

<Layout title="Anasayfa">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <section class="border-b border-black/5 bg-gradient-to-br from-marka/10 via-zemin to-zemin">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-murekkep sm:text-5xl">
        Gündemi <span class="text-marka">sosyektif</span> bakış açısından oku
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-murekkep/70">
        Listeler, bilmediğin bilgiler ve kısa quizlerle her gün tazelenen içerik akışı.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    {yazilar.length === 0 ? (
      <p class="text-center text-murekkep/60">Henüz içerik yayınlanmadı. Çok yakında burada olacak!</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {yazilar.map((yazi) => <PostCard post={yazi} />)}
      </div>
    )}
  </section>
</Layout>
