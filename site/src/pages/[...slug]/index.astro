---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { guvenliJson } from '../../lib/html';
import ListeIcerik from '../../components/ListeIcerik.astro';
import TriviaIcerik from '../../components/TriviaIcerik.astro';
import QuizIcerik from '../../components/QuizIcerik.astro';
import KisilikTestiIcerik from '../../components/KisilikTestiIcerik.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import IlgiliIcerikler from '../../components/IlgiliIcerikler.astro';
import SiradakiIcerik from '../../components/SiradakiIcerik.astro';
import Yorumlar from '../../components/Yorumlar.astro';
import { KATEGORILER, FORMAT_ETIKETLERI } from '../../lib/kategoriler';
import { etiketSlugla } from '../../lib/etiketler';
import ReklamAlani from '../../components/ReklamAlani.astro';
import TepkiBari from '../../components/TepkiBari.astro';

export async function getStaticPaths() {
  const yazilar = await getCollection('posts', ({ data }) => !data.taslak);
  return yazilar.map((yazi) => ({
    params: { slug: yazi.id },
    props: { yazi },
  }));
}

const { yazi } = Astro.props;
const { Content } = await render(yazi);
const tumYazilar = await getCollection('posts', ({ data }) => !data.taslak);
const {
  baslik,
  seoBaslik,
  metaAciklama,
  format,
  kategori,
  kapakGorseli,
  kapakGorselAlt,
  gorselKredisi,
  listeMaddeleri,
  quizSorulari,
  kisilikSonuclari,
  kisilikSorulari,
  kaynaklar,
  yayinTarihi,
  guncellemeTarihi,
  etiketler,
  duzeltmeNotu,
  seri,
} = yazi.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: baslik,
  description: metaAciklama,
  image: [new URL(kapakGorseli, Astro.site).toString()],
  datePublished: yayinTarihi.toISOString(),
  dateModified: (guncellemeTarihi ?? yayinTarihi).toISOString(),
  author: { '@type': 'Organization', name: 'sosyektif' },
  publisher: { '@type': 'Organization', name: 'sosyektif' },
};

const tarihFormati = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Istanbul',
});

const sayfaUrl = new URL(`/${yazi.id}/`, Astro.site).toString();

// Quiz bitince "sıradaki test"e tek tıkla geçiş için: aynı formattaki en
// yeni diğer yazı (yayın tarihine göre), yoksa null.
const digerQuizler = tumYazilar
  .filter((y) => y.data.format === 'quiz' && y.id !== yazi.id)
  .sort((a, b) => b.data.yayinTarihi.valueOf() - a.data.yayinTarihi.valueOf());
const sonrakiTest = digerQuizler[0] ?? null;
---

<Layout title={seoBaslik} description={metaAciklama} image={kapakGorseli}>
  <script type="application/ld+json" is:inline set:html={guvenliJson(jsonLd)} />

  <div id="okuma-ilerleme" class="fixed left-0 top-0 z-50 h-1 w-0 bg-marka transition-[width]"></div>

  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-wide text-marka">
      {KATEGORILER[kategori].emoji} {KATEGORILER[kategori].etiket} · {FORMAT_ETIKETLERI[format]}
    </p>
    <h1 class="mt-2 text-3xl font-extrabold leading-tight text-murekkep sm:text-4xl">{baslik}</h1>

    {seri && (
      <a
        href={`/seri/${etiketSlugla(seri)}/`}
        class="mt-3 inline-flex items-center gap-1 rounded-full bg-murekkep/5 px-3 py-1 text-xs font-semibold text-murekkep/70 transition hover:bg-marka/10 hover:text-marka"
      >
        📁 {seri} serisinin bir parçası
      </a>
    )}

    <p class="mt-3 text-xs text-murekkep/50">
      <time datetime={yayinTarihi.toISOString()}>{tarihFormati.format(yayinTarihi)}</time> tarihinde yayınlandı
      {guncellemeTarihi && (
        <> · <time datetime={guncellemeTarihi.toISOString()}>{tarihFormati.format(guncellemeTarihi)}</time> tarihinde güncellendi</>
      )}
    </p>

    <figure class="mt-6 overflow-hidden rounded-2xl">
      <img src={kapakGorseli} alt={kapakGorselAlt} class="w-full object-cover" />
      {gorselKredisi && (
        <figcaption class="mt-1 text-xs text-murekkep/50">{gorselKredisi}</figcaption>
      )}
    </figure>

    <ReklamAlani konum="icerik-ustu" />

    {duzeltmeNotu && (
      <aside class="mt-6 rounded-2xl border-2 border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
        <p class="font-semibold">✏️ Düzeltme</p>
        <p class="mt-1">{duzeltmeNotu}</p>
      </aside>
    )}

    <div class="prose prose-neutral mt-8 max-w-none prose-headings:font-bold">
      <Content />
    </div>

    {etiketler.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {etiketler.map((etiket) => (
          <a
            href={`/etiket/${etiketSlugla(etiket)}/`}
            class="rounded-full bg-black/5 px-3 py-1 text-xs font-semibold text-murekkep/70 transition hover:bg-marka/10 hover:text-marka"
          >
            #{etiket}
          </a>
        ))}
      </div>
    )}

    {format === 'liste' && listeMaddeleri && (
      <div class="mt-8"><ListeIcerik maddeler={listeMaddeleri} /></div>
    )}
    {format === 'trivia' && listeMaddeleri && (
      <div class="mt-8"><TriviaIcerik maddeler={listeMaddeleri} /></div>
    )}
    {format === 'quiz' && quizSorulari && (
      <div class="mt-8">
        <QuizIcerik
          sorular={quizSorulari}
          baslik={baslik}
          sayfaUrl={sayfaUrl}
          sonrakiTestUrl={sonrakiTest ? `/${sonrakiTest.id}/` : undefined}
          sonrakiTestBaslik={sonrakiTest?.data.baslik}
        />
      </div>
    )}
    {format === 'kisilik' && kisilikSonuclari && kisilikSorulari && (
      <div class="mt-8">
        <KisilikTestiIcerik sonuclar={kisilikSonuclari} sorular={kisilikSorulari} baslik={baslik} sayfaUrl={sayfaUrl} />
      </div>
    )}

    {kaynaklar.length > 0 && (
      <aside class="mt-10 rounded-2xl bg-black/5 p-5 text-sm text-murekkep/70">
        <h2 class="mb-2 font-semibold text-murekkep">Kaynaklar</h2>
        <ul class="list-inside list-disc space-y-1">
          {kaynaklar.map((kaynak) => (
            <li>
              <a href={kaynak.url} class="underline hover:text-marka" rel="nofollow noopener" target="_blank">
                {kaynak.baslik}
              </a>
              {kaynak.atif && <span class="text-xs"> — {kaynak.atif}</span>}
            </li>
          ))}
        </ul>
      </aside>
    )}

    <TepkiBari slug={yazi.id} />

    <ReklamAlani konum="icerik-arasi" />

    <div class="mt-8 border-t border-black/5 pt-6">
      <ShareButtons url={sayfaUrl} baslik={baslik} />
    </div>

    <SiradakiIcerik mevcut={yazi} tumYazilar={tumYazilar} />

    <IlgiliIcerikler mevcut={yazi} tumYazilar={tumYazilar} />

    <section class="mt-12 border-t border-black/5 pt-8">
      <h2 class="mb-4 text-xl font-bold text-murekkep">Yorumlar</h2>
      <Yorumlar />
    </section>
  </article>

  <script>
    // Okuma ilerleme çubuğu (PLAN.md Bölüm 10 / S4). Makale gövdesinin ne
    // kadarının okunduğunu üstteki ince şeritle gösterir.
    const cubuk = document.getElementById('okuma-ilerleme');
    const gövde = document.querySelector('article');
    if (cubuk && gövde) {
      const guncelle = () => {
        const { top, height } = gövde.getBoundingClientRect();
        const okunabilirYukseklik = height - window.innerHeight;
        const kaydirilan = -top;
        const oran = okunabilirYukseklik > 0 ? Math.min(1, Math.max(0, kaydirilan / okunabilirYukseklik)) : 0;
        cubuk.style.width = `${oran * 100}%`;
      };
      document.addEventListener('scroll', guncelle, { passive: true });
      guncelle();
    }
  </script>
</Layout>
