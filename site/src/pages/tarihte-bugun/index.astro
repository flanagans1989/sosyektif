---
import Layout from '../../layouts/Layout.astro';
import veri from '../../data/tarihte-bugun.json';

// Seçki her sabah ajan tarafından üretilir (agents/src/orchestrator/tarihteBugun.ts):
// Vikipedi'nin o güne ait kayıtlarından bilim, keşif, icat, sanat gibi şaşırtıcı
// ve hoş olanlar seçilip yeniden yazılır; afet, savaş, siyaset elenir.
interface Olay {
  yil: number;
  baslik: string;
  metin: string;
  kategori: string;
  kaynakUrl?: string;
}

const KATEGORI_BILGISI: Record<string, { emoji: string; etiket: string }> = {
  bilim: { emoji: '🔬', etiket: 'Bilim' },
  uzay: { emoji: '🚀', etiket: 'Uzay' },
  icat: { emoji: '💡', etiket: 'İcat' },
  kesif: { emoji: '🧭', etiket: 'Keşif' },
  sanat: { emoji: '🎨', etiket: 'Sanat' },
  spor: { emoji: '🏅', etiket: 'Spor' },
  tarih: { emoji: '🏛️', etiket: 'Tarih' },
  dogum: { emoji: '🎂', etiket: 'Doğum günü' },
};

const olaylar = veri.olaylar as Olay[];
const gunEtiketi = veri.tarih
  ? new Date(`${veri.tarih}T00:00:00Z`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'UTC' })
  : '';
const sayfaUrl = new URL('/tarihte-bugun/', Astro.site).toString();
const paylasimUrl = `https://wa.me/?text=${encodeURIComponent(`${gunEtiketi || 'Bugün'} tarihte neler olmuş, bir bak 📅 ${sayfaUrl}`)}`;
---

<Layout
  title={gunEtiketi ? `Tarihte Bugün: ${gunEtiketi}` : 'Tarihte Bugün'}
  description={`${gunEtiketi || 'Bugün'} tarihinde yaşanmış şaşırtıcı keşifler, icatlar ve ilginç anlar. Her gün yenilenir.`}
>
  <div class="mx-auto max-w-2xl px-4 py-10">
    <h1 class="text-3xl font-extrabold text-murekkep">📅 Tarihte Bugün</h1>
    <p class="mt-2 text-murekkep/70">
      {gunEtiketi
        ? `${gunEtiketi} tarihinde yaşanmış şaşırtıcı keşifler, icatlar ve ilginç anlar.`
        : 'Geçmişte bugün yaşanmış şaşırtıcı keşifler, icatlar ve ilginç anlar.'}
    </p>

    {olaylar.length === 0 ? (
      <p class="mt-8 rounded-2xl bg-black/5 p-6 text-center text-murekkep/60">Bugünün seçkisi hazırlanıyor, birazdan burada! ⏳</p>
    ) : (
      <ol class="mt-8 flex flex-col gap-5 border-l-2 border-marka/20 pl-6">
        {olaylar.map((olay) => {
          const bilgi = KATEGORI_BILGISI[olay.kategori] ?? KATEGORI_BILGISI.tarih;
          return (
            <li class="relative">
              <span class="absolute -left-[31px] top-6 h-3 w-3 rounded-full bg-marka ring-4 ring-zemin" aria-hidden="true"></span>
              <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5">
                <div class="flex items-center gap-2 text-xs font-semibold">
                  <span class="rounded-full bg-marka px-2.5 py-0.5 text-white">{olay.yil}</span>
                  <span class="text-marka">{bilgi.emoji} {bilgi.etiket}</span>
                </div>
                <h2 class="mt-2 text-lg font-bold leading-snug text-murekkep">{olay.baslik}</h2>
                <p class="mt-1 leading-relaxed text-murekkep/80">{olay.metin}</p>
                {olay.kaynakUrl && (
                  <a
                    href={olay.kaynakUrl}
                    target="_blank"
                    rel="nofollow noopener"
                    class="mt-2 inline-block text-xs font-semibold text-marka hover:underline"
                  >
                    Vikipedi'de oku →
                  </a>
                )}
              </article>
            </li>
          );
        })}
      </ol>
    )}

    <div class="mt-8 flex justify-center">
      <a
        href={paylasimUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 rounded-full bg-[#25D366] px-5 py-2 text-sm font-bold text-white transition hover:opacity-90"
      >
        WhatsApp'ta Paylaş
      </a>
    </div>

    <p class="mt-6 text-center text-xs text-murekkep/40">
      Kaynak: Vikipedi (CC BY-SA). Seçki ve anlatım sosyektif'e aittir, her gün yenilenir.
    </p>
  </div>
</Layout>
