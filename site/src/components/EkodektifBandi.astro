---
import EkodektifLogo from './EkodektifLogo.astro';

// Ana sayfadaki kompakt Ekodektif şeridi: logo + "Canlı" rozeti, dört canlı
// fiyat kutusu (Bitcoin'inkinde gerçek 7 günlük mini grafik) ve giriş linki.
// Masaüstünde tek satır; telefonda kutular 2x2 dizilir. Veriler tarayıcıda
// çekilir (lib/piyasa.ts); gelene kadar "—" görünür, ölçüler sabit, sayfa kaymaz.

const KUTUCUKLAR = [
  { anahtar: 'USD', ad: 'Dolar' },
  { anahtar: 'EUR', ad: 'Euro' },
  { anahtar: 'gram-altin', ad: 'Gram Altın' },
  { anahtar: 'bitcoin', ad: 'Bitcoin', grafik: true },
];
---

<section class="mx-auto max-w-6xl px-4 pt-6" aria-labelledby="eko-bant-baslik">
  <h2 id="eko-bant-baslik" class="sr-only">Ekodektif canlı piyasa</h2>
  <div class="relative isolate overflow-hidden rounded-2xl bg-murekkep text-white">
    <div class="eko-doku pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="flex flex-col gap-3 p-3 sm:p-4 lg:flex-row lg:items-center lg:gap-5 lg:px-5">
      <div class="flex items-center justify-between gap-3 lg:shrink-0">
        <a href="/ekodektif/" class="flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300">
          <EkodektifLogo class="text-xl !text-white" />
          <span class="inline-flex items-center gap-1.5 rounded-full bg-eko/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-emerald-300">
            <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            </span>
            Canlı
          </span>
        </a>
        <a href="/ekodektif/" class="text-sm font-bold text-emerald-300 hover:text-emerald-200 lg:hidden">Keşfet →</a>
      </div>

      <a
        href="/ekodektif/"
        class="grid flex-1 grid-cols-2 gap-2 rounded-xl sm:grid-cols-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300"
        aria-label="Ekodektif canlı piyasa panosuna git"
      >
        {KUTUCUKLAR.map((k) => (
          <div class="relative overflow-hidden rounded-xl bg-white/[0.06] px-3 py-2 ring-1 ring-white/10 transition hover:bg-white/10" data-bant-kalem={k.anahtar}>
            <div class="relative">
              <p class="text-[10px] font-semibold uppercase tracking-wider text-white/50">{k.ad}</p>
              <p class="whitespace-nowrap text-sm font-extrabold tabular-nums sm:text-base" data-alan="fiyat">—</p>
              <p class="text-[11px] font-semibold tabular-nums text-white/40" data-alan="degisim">&nbsp;</p>
            </div>
            {k.grafik && (
              <svg id="eko-bant-grafik" class="pointer-events-none absolute inset-x-0 bottom-0 h-5 w-full opacity-40" viewBox="0 0 80 32" preserveAspectRatio="none" aria-hidden="true">
                <path data-grafik="cizgi" d="" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
              </svg>
            )}
          </div>
        ))}
      </a>

      <a
        href="/ekodektif/"
        class="group hidden shrink-0 items-center gap-1.5 rounded-full bg-eko px-4 py-2 text-sm font-bold text-white transition hover:bg-emerald-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300 lg:inline-flex"
      >
        Ekodektif
        <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { bitcoinHaftalik, fiyatlariAl, tlBicimle, yuzdeBicimle } from '../lib/piyasa';

  const YENILEME_MS = 60_000;

  async function fiyatlariCiz(): Promise<void> {
    const fiyatlar = await fiyatlariAl();
    document.querySelectorAll<HTMLElement>('[data-bant-kalem]').forEach((kutu) => {
      const f = fiyatlar.get(kutu.dataset.bantKalem ?? '');
      if (!f) return;
      const fiyatEl = kutu.querySelector<HTMLElement>('[data-alan="fiyat"]');
      const degisimEl = kutu.querySelector<HTMLElement>('[data-alan="degisim"]');
      if (fiyatEl) fiyatEl.textContent = `${tlBicimle(f.tl)} ₺`;
      if (degisimEl) {
        degisimEl.textContent = yuzdeBicimle(f.degisim);
        degisimEl.classList.remove('text-white/40', 'text-emerald-400', 'text-rose-400');
        degisimEl.classList.add(f.degisim < 0 ? 'text-rose-400' : 'text-emerald-400');
      }
    });
  }

  async function grafigiCiz(): Promise<void> {
    const svg = document.getElementById('eko-bant-grafik');
    if (!svg) return;
    const fiyatlar = await bitcoinHaftalik();
    if (fiyatlar.length < 2) return;

    const en = 80;
    const boy = 32;
    const kenar = 4;
    const min = Math.min(...fiyatlar);
    const aralik = Math.max(...fiyatlar) - min || 1;
    const noktalar = fiyatlar.map((f, i) => {
      const x = (i / (fiyatlar.length - 1)) * en;
      const y = kenar + (1 - (f - min) / aralik) * (boy - kenar * 2);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    });
    svg.querySelector('[data-grafik="cizgi"]')?.setAttribute('d', `M${noktalar.join(' L')}`);
    svg.classList.add(fiyatlar[fiyatlar.length - 1] < fiyatlar[0] ? 'text-rose-400' : 'text-emerald-400');
  }

  fiyatlariCiz().catch(() => {});
  grafigiCiz().catch(() => {});
  setInterval(() => fiyatlariCiz().catch(() => {}), YENILEME_MS);
</script>
