---
import { KATEGORILER } from '../lib/kategoriler';

const kategoriGirdileri = Object.entries(KATEGORILER);
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-zemin/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="text-2xl font-extrabold tracking-tight text-murekkep">
      sos<span class="text-marka">yektif</span>
    </a>

    <nav class="hidden gap-1 md:flex" aria-label="Kategoriler">
      {kategoriGirdileri.map(([anahtar, { etiket }]) => (
        <a
          href={`/kategori/${anahtar}/`}
          class="rounded-full px-3 py-1.5 text-sm font-medium text-murekkep/70 transition hover:bg-marka/10 hover:text-marka"
        >
          {etiket}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/tarihte-bugun/"
        class="hidden items-center gap-1 rounded-full px-3 py-1.5 text-sm font-semibold text-murekkep/70 transition hover:bg-marka/10 hover:text-marka lg:inline-flex"
      >
        📅 Tarihte Bugün
      </a>
      <a
        href="/gunun-sorusu/"
        class="hidden items-center gap-1 rounded-full px-3 py-1.5 text-sm font-semibold text-murekkep/70 transition hover:bg-marka/10 hover:text-marka md:inline-flex"
      >
        🎯 Günün Sorusu
      </a>
      <a
        href="/burc/"
        class="hidden items-center gap-1 rounded-full px-3 py-1.5 text-sm font-semibold text-murekkep/70 transition hover:bg-marka/10 hover:text-marka sm:inline-flex"
      >
        🔮 Burç
      </a>
      <a
        href="/ara/"
        aria-label="Ara"
        class="rounded-full p-2 text-murekkep/70 transition hover:bg-black/5 hover:text-marka"
      >
        🔍
      </a>
      <a
        href="/"
        class="rounded-full bg-marka px-4 py-2 text-sm font-semibold text-white transition hover:bg-marka-koyu"
      >
        Keşfet
      </a>
    </div>
  </div>

  <nav class="flex gap-1 overflow-x-auto px-4 pb-3 md:hidden" aria-label="Kategoriler (mobil)">
    <a
      href="/gunun-sorusu/"
      class="whitespace-nowrap rounded-full bg-marka/10 px-3 py-1 text-xs font-bold text-marka"
    >
      🎯 Günün Sorusu
    </a>
    <a
      href="/tarihte-bugun/"
      class="whitespace-nowrap rounded-full bg-black/5 px-3 py-1 text-xs font-medium text-murekkep/70"
    >
      📅 Tarihte Bugün
    </a>
    <a
      href="/burc/"
      class="whitespace-nowrap rounded-full bg-black/5 px-3 py-1 text-xs font-medium text-murekkep/70"
    >
      🔮 Burç
    </a>
    {kategoriGirdileri.map(([anahtar, { etiket }]) => (
      <a
        href={`/kategori/${anahtar}/`}
        class="whitespace-nowrap rounded-full bg-black/5 px-3 py-1 text-xs font-medium text-murekkep/70"
      >
        {etiket}
      </a>
    ))}
  </nav>
</header>
