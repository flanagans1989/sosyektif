---
import { KATEGORILER } from '../lib/kategoriler';

const kategoriGirdileri = Object.entries(KATEGORILER);
const kesifLinkleri = [
  { href: '/gunun-sorusu/', etiket: 'Günün Sorusu', emoji: '🎯' },
  { href: '/tarihte-bugun/', etiket: 'Tarihte Bugün', emoji: '📅' },
  { href: '/burc/', etiket: 'Burç', emoji: '🔮' },
];
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-zemin/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="shrink-0 text-2xl font-extrabold tracking-tight text-murekkep">
      sos<span class="text-marka">yektif</span>
    </a>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href="/ara/"
        aria-label="Ara"
        class="rounded-full p-2 text-murekkep/70 transition hover:bg-black/5 hover:text-marka"
      >
        🔍
      </a>
      <a
        href="/"
        class="rounded-full bg-marka px-4 py-2 text-sm font-semibold text-white transition hover:bg-marka-koyu"
      >
        Keşfet
      </a>
    </div>
  </div>

  <!-- Tüm ekran genişliklerinde aynı, tek satırlık, taşınca yana kayan şerit —
       ayrı masaüstü/mobil sürümlerin farklı kırılma noktalarında metinlerin
       satıra bölünüp barı düzensiz göstermesini önler. -->
  <nav class="flex gap-1.5 overflow-x-auto px-4 pb-3" aria-label="Keşfet ve kategoriler">
    {kesifLinkleri.map(({ href, etiket, emoji }) => (
      <a
        href={href}
        class="shrink-0 whitespace-nowrap rounded-full bg-marka/10 px-3 py-1.5 text-sm font-bold text-marka transition hover:bg-marka/20"
      >
        {emoji} {etiket}
      </a>
    ))}
    <span class="mx-1 my-auto h-5 w-px shrink-0 bg-black/10" aria-hidden="true"></span>
    {kategoriGirdileri.map(([anahtar, { etiket }]) => (
      <a
        href={`/kategori/${anahtar}/`}
        class="shrink-0 whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-medium text-murekkep/70 transition hover:bg-black/5 hover:text-marka"
      >
        {etiket}
      </a>
    ))}
  </nav>
</header>
