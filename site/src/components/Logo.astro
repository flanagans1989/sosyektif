---
// "sosyektif" = sosyal + dedektif. Ortadaki "o" harfini saran büyüteç bu
// birleşimi görsel olarak da anlatıyor. Metin gerçek HTML metni (erişilebilir
// ve seçilebilir kalsın diye) — büyüteç yalnızca em birimiyle boyutlanan,
// harfin üzerine bindirilen dekoratif bir SVG.
interface Props {
  class?: string;
}

const { class: className = 'text-2xl' } = Astro.props;
---

<span class={`inline-flex items-center font-extrabold tracking-tight text-murekkep ${className}`}>
  s<span class="relative inline-block leading-none">
    o
    <svg
      class="pointer-events-none absolute left-1/2 bottom-[0.05em] h-[1.05em] w-[1.05em] -translate-x-1/2 text-marka"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      aria-hidden="true"
    >
      <circle cx="10" cy="10" r="7.5" />
      <line x1="20.5" y1="20.5" x2="15.2" y2="15.2" stroke-linecap="round" />
    </svg>
  </span>s<span class="text-marka">yektif</span>
</span>
