---
// Kayan piyasa şeridi. Veri lib/piyasa.ts'ten (truncgil + CoinGecko, anahtarsız,
// ziyaretçinin tarayıcısından) — Ekodektif bandı ve sayfasıyla aynı istek paylaşılır.
---

<div id="piyasa-seridi" class="overflow-hidden border-b border-black/10 bg-murekkep" aria-label="Canlı piyasa verileri">
  <div id="piyasa-icerik" class="flex w-max animate-piyasa-kaydir whitespace-nowrap py-1.5 text-xs font-semibold text-white/90">
    <span class="px-3 text-white/40">Piyasa verileri yükleniyor…</span>
  </div>
</div>

<style>
  @keyframes piyasa-kaydir {
    from {
      transform: translateX(0);
    }
    to {
      /* İçerik iki kez art arda basılıyor; %50 tam bir tur demek — dikişsiz döngü. */
      transform: translateX(-50%);
    }
  }
  .animate-piyasa-kaydir {
    animation: piyasa-kaydir 35s linear infinite;
  }
  #piyasa-seridi:hover .animate-piyasa-kaydir {
    animation-play-state: paused;
  }
  /* Piksel hızı her ekranda aynı olsa da dar ekranda aynı anda bir-iki kalem
     göründüğü için şerit yavaş hissettiriyordu; telefonda daha hızlı akar. */
  @media (max-width: 767px) {
    .animate-piyasa-kaydir {
      animation-duration: 18s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-piyasa-kaydir {
      animation: none;
    }
  }
</style>

<script>
  import { fiyatlariAl, tlBicimle, yuzdeBicimle } from '../lib/piyasa';

  const YENILEME_MS = 60_000;
  const KALEMLER: [emoji: string, ad: string, anahtar: string][] = [
    ['💵', 'Dolar', 'USD'],
    ['💶', 'Euro', 'EUR'],
    ['🪙', 'Gram Altın', 'gram-altin'],
    ['🥈', 'Gümüş', 'gumus'],
    ['₿', 'Bitcoin', 'bitcoin'],
    ['Ξ', 'Ethereum', 'ethereum'],
  ];

  async function guncelle(): Promise<void> {
    const icerik = document.getElementById('piyasa-icerik');
    if (!icerik) return;

    const fiyatlar = await fiyatlariAl();
    const ogeler = KALEMLER.flatMap(([emoji, ad, anahtar]) => {
      const f = fiyatlar.get(anahtar);
      if (!f) return [];
      const renk = f.degisim < 0 ? 'text-red-400' : 'text-emerald-400';
      return [
        `<span class="flex items-center gap-1.5 px-4">${emoji} ${ad}: <b>${tlBicimle(f.tl)} ₺</b> <span class="${renk}">${yuzdeBicimle(f.degisim)}</span></span>`,
      ];
    });

    if (ogeler.length === 0) {
      icerik.innerHTML = '<span class="px-3 text-white/40">Piyasa verileri şu an alınamıyor.</span>';
      return;
    }
    // Kayan şerit dikişsiz dönsün diye içerik iki kez art arda basılıyor.
    icerik.innerHTML = ogeler.join('') + ogeler.join('');
  }

  guncelle();
  setInterval(guncelle, YENILEME_MS);
</script>
